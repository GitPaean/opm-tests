---------------------------------------------------------------------------
SUMMARY

FOPR
GOPR
   'G_NONE' 'G_CON' 'G_PCON' 'G_WELL' 'G_PLUG' 'G_RATE' 'G_MIX' 'G_ORAT' /
GMCTP
   'G_NONE' 'G_CON' 'G_PCON' 'G_WELL' 'G_PLUG' 'G_RATE' 'G_MIX' 'G_ORAT' /
WOPR
/
WSTAT
/

---------------------------------------------------------------------------
SCHEDULE
---------------------------------------------------------------------------

RPTRST
   BASIC=2 /

GRUPTREE
   'G_NONE' 'FIELD' /
   'G_CON'  'FIELD' /
   'G_PCON' 'FIELD' /
   'G_WELL' 'FIELD' /
   'G_PLUG' 'FIELD' /
   'G_RATE' 'FIELD' /
   'G_MIX'  'FIELD' /
   'G_ORAT' 'FIELD' /
/

WELSPECS
   'P_NONE' 'G_NONE'  1  1 1* 'OIL' /
   'P_CON'  'G_CON'   1 10 1* 'OIL' /
   'P_PCON' 'G_PCON' 10  1 1* 'OIL' /
   'P_WELL' 'G_WELL' 10 10 1* 'OIL' /
   'P_PLUG' 'G_PLUG'  5  5 1* 'OIL' /
   'P_RATE' 'G_RATE'  3  7 1* 'OIL' /
   'P_MIX'  'G_MIX'   7  3 1* 'OIL' /
   'P_ORAT' 'G_ORAT'  8  8 1* 'OIL' /
/

COMPDAT
   'P_NONE'  1  1 3 3 'OPEN' 1* 1* 0.5 /
   'P_CON'   1 10 3 3 'OPEN' 1* 1* 0.5 /
   'P_PCON' 10  1 3 3 'OPEN' 1* 1* 0.5 /
   'P_WELL' 10 10 3 3 'OPEN' 1* 1* 0.5 /
   'P_PLUG'  5  5 3 3 'OPEN' 1* 1* 0.5 /
   'P_RATE'  3  7 3 3 'OPEN' 1* 1* 0.5 /
   'P_MIX'   7  3 3 3 'OPEN' 1* 1* 0.5 /
   'P_ORAT'  8  8 3 3 'OPEN' 1* 1* 0.5 /
/

WCONPROD
   'P_*' 'OPEN' 'ORAT' 1000 4* 1000 /
/

GCONPROD
-- group    mode    oil     water   gas     liquid  proc    avail guide def  water   gas    liquid
   'G_NONE' 'NONE'  1*      1*      1*      100000  'NONE'  /
   'G_CON'  'NONE'  1*      1*      1*      100000  'CON'   /
   'G_PCON' 'NONE'  1*      1*      1*      100000  '+CON'  /
   'G_WELL' 'NONE'  1*      1*      1*      100000  'WELL'  /
   'G_PLUG' 'NONE'  1*      1*      1*      100000  'PLUG'  /
   'G_RATE' 'NONE'  1*      1*      1*      100000  'RATE'  /
   'G_MIX'  'NONE'  100000  100000  1.0E9   100000  'CON'   'YES' 1*    1*   '+CON'  'PLUG' 'WELL' /
   'G_ORAT' 'ORAT'  100000  1*      1*      1*      'CON'   /
/

TSTEP
   1 30 /

END
