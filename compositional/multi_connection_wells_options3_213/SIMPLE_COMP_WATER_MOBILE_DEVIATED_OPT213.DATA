------------------------------------------------------------------------
SCHEDULE
------------------------------------------------------------------------

INCLUDE
 'include/REPORTING_corrected.inc' /


WELSPECS
INJ  FIELD  1 1 2.5 GAS /
PROD FIELD 28 1 2.5 GAS /
/
COMPDAT
INJ   1 1 1 3 OPEN 2* 0.0151 /
PROD 28 1 1 1 OPEN 2* 0.0151 3* X /
PROD 29 1 2 2 OPEN 2* 0.0151 3* X /
PROD 30 1 3 3 OPEN 2* 0.0151 3* X /
/

WELLSTRE
ISTR 1.0 0.0 0.0 /
/

WINJGAS
INJ STREAM ISTR /
/

WCONINJE
INJ GAS OPEN BHP 1e7 1* 150 /
/

WCONPROD
PROD OPEN BHP 2* 100000 2* 50 /
/

TSTEP
0.01 0.02 0.04 0.08 0.15 0.3 0.4
9*1.0
20*2.0
/
END
